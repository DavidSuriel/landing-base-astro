---
// Hero con medio intercambiable. Por defecto, según hero.modo: imagen (también SVG estático) o video con portada.
// Para cualquier otro medio (3D, ilustración SVG animada de anatomy, composición propia) pásalo como hijo desde Landing.astro:
//   <Hero><Hero3D /></Hero>   ·   <Hero><Ilustracion /></Hero>
// El hijo reemplaza al bloque de imagen/video; textos, CTA y data-hero (que usa el botón flotante) se mantienen.
import { getContent, mainContact } from '../lib/content';
import MediaImage from './MediaImage.astro';
import HeroVideo from './HeroVideo.astro';
import Icon from './Icon.astro';
const data = getContent(Astro.params.lang);
const video = data.hero.videoExterno || data.hero.video;
const hasVideo = data.hero.modo === 'video' && !!video;
const custom = Astro.slots.has('default');
---
<section class="hero wrap" aria-labelledby="hero-title" data-hero>
  <div class="hero-copy">
    {data.hero.etiqueta && <p class="eyebrow">{data.hero.etiqueta}</p>}
    <h1 id="hero-title">{data.hero.titulo}</h1>
    <p class="lead">{data.hero.subtitulo}</p>
    <a class="button" href={mainContact(data)}>{data.hero.cta}<Icon /></a>
  </div>
  {custom ? <slot /> : (data.hero.imagen || hasVideo) && <div class="hero-media" data-hero-media>
    <MediaImage src={data.hero.imagen} alt={data.hero.alt} eager />
    {hasVideo && <HeroVideo src={video} />}
  </div>}
</section>
