---
// Resuelve las rutas /src/assets/images/... que guarda Pages CMS y genera imágenes optimizadas.
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
interface Props { src?: string; alt?: string; eager?: boolean; priority?: 'high' | 'low' | 'auto'; widths?: number[]; sizes?: string; class?: string }
const { src, alt = '', eager = false, widths = [480, 800, 1280], sizes = '(max-width: 700px) 100vw, 60vw', class: className } = Astro.props;
const priority = Astro.props.priority ?? (eager ? 'high' : 'auto');
const image = resolveImage(src);
---
{image && <Image src={image} alt={alt} class={className} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={priority} />}
