---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
interface Props { src?: string; alt?: string; eager?: boolean; class?: string }
const { src, alt = '', eager = false, class: className } = Astro.props;
const image = resolveImage(src);
---
{image && <Image src={image} alt={alt} class={className} widths={[480, 800, 1280]} sizes="(max-width: 700px) 100vw, 60vw" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />}
