---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Contact from '../components/Contact.astro';
import MediaImage from '../components/MediaImage.astro';
import data from '../lib/content';
const services = data.servicios.filter(s => s.nombre);
const projects = data.proyectos as { titulo: string; descripcion?: string; foto?: string; alt?: string }[];
---
<Layout>
  <header class="wrap header">
    <a href="/" class="brand" aria-label={data.negocio.nombre}>{data.negocio.logo ? <MediaImage src={data.negocio.logo} alt={data.negocio.nombre} /> : data.negocio.nombre}</a>
    <nav aria-label="Principal">
      {services.length > 0 && <a href="#servicios">{data.interfaz.menuServicios}</a>}
      {projects.length > 0 && <a href="#proyectos">{data.interfaz.menuProyectos}</a>}
      <a href="#contacto">{data.interfaz.menuContacto}</a>
    </nav>
  </header>
  <main id="contenido">
    <Hero />
    {services.length > 0 && <section id="servicios" class="wrap section" aria-labelledby="services-title">
      <h2 id="services-title">{data.secciones.servicios}</h2>
      <div class="service-grid">{services.map((s, i) => <article class="service">
        <span class="number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <MediaImage src={s.foto} alt={s.alt} />
        <h3>{s.nombre}</h3><p>{s.descripcion}</p>
      </article>)}</div>
    </section>}
    {projects.length > 0 && <section id="proyectos" class="wrap section" aria-labelledby="projects-title">
      <h2 id="projects-title">{data.secciones.proyectos}</h2>
      <div class="service-grid">{projects.filter(p => p.titulo).map(p => <article class="service"><MediaImage src={p.foto} alt={p.alt} /><h3>{p.titulo}</h3><p>{p.descripcion}</p></article>)}</div>
    </section>}
    <Contact />
  </main>
  <footer class="wrap footer"><span>© {new Date().getFullYear()} {data.negocio.nombre}</span><span>{data.interfaz.derechos}</span></footer>
</Layout>
