---
// Módulo opcional: modelo 3D en el hero. Ver modulos/hero-3d/README.md antes de copiarlo a src/components/.
import { getContent } from '../lib/content';
import MediaImage from './MediaImage.astro';
const data = getContent(Astro.params.lang);
---
<div class="hero-media hero-3d" data-hero-3d data-model="/modelos/hero.glb">
  <MediaImage src={data.hero.imagen} alt={data.hero.alt} eager />
  <canvas data-hero-canvas aria-hidden="true" hidden></canvas>
</div>
<style>
  .hero-3d canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-3d > img { transition: opacity .4s ease; }
  .hero-3d.is-live > img { opacity: 0; }
</style>
<script>
  type Nav = Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const nav = navigator as Nav;
  const box = document.querySelector<HTMLElement>('[data-hero-3d]');
  const canvas = box?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');

  // Solo escritorio capaz: sin movimiento reducido, sin ahorro de datos, con WebGL y equipo de al menos 4 GB / 4 núcleos.
  // El resto ve la imagen de portada (render real del modelo); three.js ni se descarga.
  const hasWebGL = () => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } };
  const allowed = window.matchMedia('(pointer: fine) and (min-width: 761px)').matches
    && !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    && nav.connection?.saveData !== true
    && (nav.deviceMemory ?? 8) >= 4
    && (nav.hardwareConcurrency ?? 8) >= 4;

  if (box && canvas && allowed) {
    // El titular es el LCP: el 3D se carga después, tras la primera interacción, en tiempo libre y con el hero a la vista.
    const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 200));
    const events = ['pointermove', 'scroll', 'keydown', 'touchstart'];
    const go = () => {
      events.forEach((e) => removeEventListener(e, go));
      idle(() => {
        const io = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          start(box, canvas).catch(() => stop(box, canvas));
        });
        io.observe(box);
      });
    };
    events.forEach((e) => addEventListener(e, go, { once: true, passive: true }));
  }

  function stop(box: HTMLElement, canvas: HTMLCanvasElement) {
    canvas.hidden = true;
    box.classList.remove('is-live');
  }

  async function start(box: HTMLElement, canvas: HTMLCanvasElement) {
    // Crear un contexto WebGL es caro: se comprueba aquí, no al abrir la página.
    if (!hasWebGL()) return stop(box, canvas);
    const THREE = await import('three');
    const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 1000);
    scene.add(new THREE.HemisphereLight(0xffffff, 0x445544, 2));
    const sun = new THREE.DirectionalLight(0xffffff, 2.5);
    sun.position.set(3, 5, 4);
    scene.add(sun);

    const gltf = await new GLTFLoader().loadAsync(box.dataset.model || '/modelos/hero.glb');
    const pivot = new THREE.Group();
    const model = gltf.scene;
    const bounds = new THREE.Box3().setFromObject(model);
    const size = bounds.getSize(new THREE.Vector3()).length() || 1;
    model.position.sub(bounds.getCenter(new THREE.Vector3()));
    pivot.add(model);
    scene.add(pivot);
    camera.position.set(0, size * 0.25, size * 1.3);
    camera.lookAt(0, 0, 0);

    const resize = () => {
      const w = box.clientWidth, h = box.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(box);
    resize();

    // Vigilante: si en los primeros 2 s no llega a 30 fps, se descarta el 3D y queda la portada.
    let frames = 0, checked = false;
    const clock = new THREE.Clock();
    const frame = () => {
      const t = clock.getElapsedTime();
      frames++;
      if (!checked && t > 2) {
        checked = true;
        if (frames / t < 30) { renderer.setAnimationLoop(null); renderer.dispose(); stop(box, canvas); return; }
      }
      const intro = 1 - Math.pow(1 - Math.min(t / 1.6, 1), 3); // entrada suave de 1.6 s
      const scroll = Math.min(window.scrollY / window.innerHeight, 1); // giro extra solo dentro del hero
      pivot.rotation.y = (1 - intro) * -1.2 + t * 0.15 + scroll * Math.PI * 0.5;
      pivot.position.y = (1 - intro) * -size * 0.15;
      renderer.render(scene, camera);
    };

    // Pausar el render cuando el hero sale de la pantalla.
    new IntersectionObserver(([entry]) => {
      if (canvas.hidden && checked) return; // ya descartado
      if (entry.isIntersecting && !checked) { frames = 0; clock.start(); } // medir fps solo con el hero a la vista
      renderer.setAnimationLoop(entry.isIntersecting ? frame : null);
    }).observe(box);

    canvas.hidden = false;
    box.classList.add('is-live');
  }
</script>
